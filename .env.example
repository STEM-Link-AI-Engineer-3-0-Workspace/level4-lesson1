# Copy to .env and fill in. Never commit .env.

# From STEMLink.
OPENAI_API_KEY=sk-...

# Free account, no card: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=pcsk_...

# Append your initials if you share a Pinecone account with anyone in the cohort.
PINECONE_INDEX=fieldoracle

# Install the "ntfy" app on your phone, subscribe to a topic you invent,
# and put the same topic name here. Anything unique — it is a public service.
NTFY_TOPIC=stemlink-yourname-8f3a
